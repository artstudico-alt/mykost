{
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "phases": {
        "setup": {
          "nixPkgs": ["nodejs", "npm"]
        },
        "build": {
          "cmds": [
            "npm install",
            "npm run build"
          ]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "npx serve -s dist -p ${PORT:-3000}",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
